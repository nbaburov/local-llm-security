# Model
OLLAMA_URL=                 # Ollama chat endpoint, e.g. http://localhost:11434/api/chat
OPENROUTER_API_KEY=         # fallback when Ollama is unreachable
SITE_URL=                   # sent to OpenRouter as referer, default http://localhost:3000
SITE_NAME=                  # sent to OpenRouter as title, default "Local LLM Demo"

# Secure chat
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=            # generate with: openssl rand -hex 32
NIGHTFALL_API_KEY=          # sensitive-data scan; skipped when empty

# Metrics
GRAFANA_API_KEY=            # bearer key for /api/metrics and /api/metrics/prometheus

# Logging (GitHub Gists); console fallback when GITHUB_TOKEN is empty
GITHUB_TOKEN=               # token with gist scope
GITHUB_GIST_API=
GITHUB_GIST_AUTH=
GITHUB_GIST_CHAT=
GITHUB_GIST_ERROR=
GITHUB_GIST_GENERAL=
